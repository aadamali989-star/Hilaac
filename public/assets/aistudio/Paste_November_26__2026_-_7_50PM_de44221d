<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HILAAC HEALTH CENTER™ — Clinical Reference &amp; Study Suite</title>
  <style>
    /* =========================================================================
       HILAAC HEALTH CENTER DESIGN SYSTEM (PLAIN VANILLA CSS, ZERO EXTERNAL DEPS)
       ========================================================================= */
    :root {
      --navy: #0B1E46;
      --navy-dark: #06122B;
      --navy-soft: #E8EEF8;
      --green: #059669;
      --green-dark: #047857;
      --green-soft: #ECFDF5;
      --red: #B91C1C;
      --red-soft: #FEF2F2;
      --blue: #1D4ED8;
      --blue-soft: #EFF6FF;
      --purple: #6D28D9;
      --purple-soft: #F5F3FF;
      --amber: #B45309;
      --amber-soft: #FFFBEB;
      --bg: #F4F7FB;
      --surface: #FFFFFF;
      --surface-2: #F8FAFC;
      --border: #D6E0EE;
      --text: #0F172A;
      --muted: #475569;
      --radius-lg: 14px;
      --radius-md: 10px;
      --radius-sm: 7px;
      --shadow: 0 2px 10px rgba(11, 30, 70, 0.06);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.5;
      overflow-x: hidden;
    }

    /* =========================================================================
       TOP HEADER, BRAND LOGO & CLINICIAN LOGIN BAR
       ========================================================================= */
    .site-header {
      background-color: var(--surface);
      border-bottom: 2px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 40;
      box-shadow: var(--shadow);
    }

    .header-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 12px 18px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }

    .brand-lockup {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-name-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .brand-title {
      font-size: 19px;
      font-weight: 900;
      color: var(--navy);
      letter-spacing: -0.01em;
    }

    .brand-tagline {
      font-size: 12px;
      font-weight: 700;
      color: var(--green);
    }

    .auth-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      background-color: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 8px 12px;
    }

    .auth-badge {
      font-size: 12px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 999px;
      background-color: var(--navy-soft);
      color: var(--navy);
    }

    .auth-badge.clinician {
      background-color: var(--green-soft);
      color: var(--green-dark);
    }

    .auth-input {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 6px 10px;
      font-size: 12px;
      color: var(--text);
      background-color: #FFFFFF;
      width: 155px;
    }

    .btn {
      border: 1px solid var(--navy);
      background-color: #FFFFFF;
      color: var(--navy);
      border-radius: var(--radius-sm);
      padding: 7px 12px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .btn:hover {
      background-color: var(--navy-soft);
    }

    .btn-navy {
      background-color: var(--navy);
      color: #FFFFFF;
    }

    .btn-navy:hover {
      background-color: var(--navy-dark);
    }

    .btn-green {
      background-color: var(--green);
      border-color: var(--green);
      color: #FFFFFF;
    }

    .btn-green:hover {
      background-color: var(--green-dark);
    }

    .btn-red-outline {
      border-color: var(--red);
      color: var(--red);
      background-color: #FFFFFF;
    }

    .btn-red-outline:hover {
      background-color: var(--red-soft);
    }

    /* =========================================================================
       STRICT SECTION NAVIGATION TABS
       ========================================================================= */
    .nav-strip {
      background-color: var(--navy);
      border-bottom: 3px solid var(--green);
    }

    .nav-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 8px 18px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .nav-tab {
      border: 1px solid rgba(255, 255, 255, 0.22);
      background-color: rgba(255, 255, 255, 0.08);
      color: #F8FAFC;
      border-radius: var(--radius-sm);
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .nav-tab:hover {
      background-color: rgba(255, 255, 255, 0.18);
    }

    .nav-tab.active {
      background-color: var(--green);
      border-color: var(--green);
      color: #FFFFFF;
    }

    /* =========================================================================
       MAIN CONTAINER & SECTION VISIBILITY
       ========================================================================= */
    .main-wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 20px 18px 40px;
    }

    .section-view {
      display: none;
    }

    .section-view.active {
      display: block;
    }

    .section-banner {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-left: 5px solid var(--navy);
      border-radius: var(--radius-lg);
      padding: 16px 20px;
      margin-bottom: 18px;
      box-shadow: var(--shadow);
    }

    .section-banner.green-border {
      border-left-color: var(--green);
    }

    .section-banner h1,
    .section-banner h2 {
      margin: 0 0 6px 0;
      font-size: 21px;
      font-weight: 900;
      color: var(--navy);
    }

    .section-banner p {
      margin: 0;
      font-size: 13px;
      color: var(--muted);
    }

    /* =========================================================================
       FILTER & SEARCH CONTROLS
       ========================================================================= */
    .controls-panel {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 14px 16px;
      margin-bottom: 18px;
      box-shadow: var(--shadow);
    }

    .search-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 12px;
      align-items: center;
    }

    .search-input {
      flex: 1 1 260px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 9px 12px;
      font-size: 13px;
      color: var(--text);
      background-color: var(--surface-2);
    }

    .filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }

    .pill-label {
      font-size: 12px;
      font-weight: 800;
      color: var(--navy);
      margin-right: 4px;
    }

    .pill-btn {
      border: 1px solid var(--border);
      background-color: var(--surface-2);
      color: var(--navy);
      border-radius: 999px;
      padding: 5px 11px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .pill-btn:hover {
      border-color: var(--navy);
      background-color: var(--navy-soft);
    }

    .pill-btn.active {
      background-color: var(--navy);
      border-color: var(--navy);
      color: #FFFFFF;
    }

    .pill-btn.green-active {
      background-color: var(--green);
      border-color: var(--green);
      color: #FFFFFF;
    }

    /* =========================================================================
       VISUAL PHARMACOLOGY CARDS & ORGAN/MOA FLOW
       ========================================================================= */
    .sub-heading {
      font-size: 16px;
      font-weight: 900;
      color: var(--navy);
      margin: 22px 0 12px;
      padding-bottom: 6px;
      border-bottom: 2px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 16px;
    }

    .pharm-card {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }

    .pharm-card-header {
      background-color: var(--navy);
      color: #FFFFFF;
      padding: 12px 16px;
      text-align: center;
    }

    .pharm-card-title {
      margin: 0;
      font-size: 17px;
      font-weight: 900;
      letter-spacing: 0.01em;
    }

    .pharm-card-subtitle {
      font-size: 11px;
      font-weight: 700;
      color: #A7F3D0;
      margin-top: 2px;
    }

    .heart-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 6px;
    }

    .heart-line {
      height: 2px;
      width: 65px;
      background-color: #EF4444;
    }

    .pharm-visual-strip {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      background-color: var(--surface-2);
      border-bottom: 1px solid var(--border);
    }

    .visual-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 4px;
    }

    .visual-caption {
      font-size: 10px;
      font-weight: 800;
      color: var(--navy);
      text-transform: uppercase;
    }

    .moa-flow {
      background-color: var(--navy-soft);
      border: 1px solid #C7D7EE;
      border-radius: var(--radius-sm);
      padding: 8px 10px;
      margin: 10px 14px 4px;
      font-size: 12px;
      font-weight: 700;
      color: var(--navy);
    }

    .pharm-body {
      padding: 10px 14px 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }

    .band-box {
      border-radius: var(--radius-sm);
      padding: 8px 10px;
      font-size: 12px;
      border: 1px solid var(--border);
    }

    .band-purple {
      background-color: var(--purple-soft);
      border-color: #DDD6FE;
    }

    .band-green {
      background-color: var(--green-soft);
      border-color: #A7F3D0;
    }

    .band-blue {
      background-color: var(--blue-soft);
      border-color: #BFDBFE;
    }

    .band-red {
      background-color: var(--red-soft);
      border-color: #FECACA;
    }

    .band-amber {
      background-color: var(--amber-soft);
      border-color: #FDE68A;
    }

    .band-title {
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      margin-bottom: 4px;
      display: block;
    }

    .band-purple .band-title { color: var(--purple); }
    .band-green .band-title { color: var(--green-dark); }
    .band-blue .band-title { color: var(--blue); }
    .band-red .band-title { color: var(--red); }
    .band-amber .band-title { color: var(--amber); }

    .pharm-body ul {
      margin: 0;
      padding-left: 16px;
    }

    .pharm-body li {
      margin-bottom: 3px;
    }

    /* =========================================================================
       TOP 209 MEDICATIONS GRID (#1 - #209)
       ========================================================================= */
    .meds-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 10px;
    }

    .med-item {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-left: 4px solid var(--green);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      box-shadow: 0 1px 4px rgba(11, 30, 70, 0.04);
    }

    .med-num {
      font-size: 11px;
      font-weight: 800;
      color: var(--green-dark);
    }

    .med-name {
      font-size: 14px;
      font-weight: 800;
      color: var(--navy);
      margin: 2px 0;
    }

    .med-cond {
      display: inline-block;
      font-size: 10px;
      font-weight: 800;
      background-color: var(--navy-soft);
      color: var(--navy);
      padding: 2px 7px;
      border-radius: 999px;
      margin-bottom: 4px;
    }

    .med-note {
      font-size: 11px;
      color: var(--muted);
      margin: 0;
    }

    /* =========================================================================
       TREATMENT PROTOCOLS, SYMPTOMS SYSTEMS & OPD GUIDE (#01 - #100)
       ========================================================================= */
    .protocol-card {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
      margin-bottom: 16px;
      box-shadow: var(--shadow);
    }

    .protocol-top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border-bottom: 2px solid var(--border);
      padding-bottom: 10px;
      margin-bottom: 12px;
    }

    .protocol-title {
      margin: 0;
      font-size: 18px;
      font-weight: 900;
      color: var(--navy);
    }

    .protocol-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      font-size: 12px;
    }

    .data-table th,
    .data-table td {
      border: 1px solid var(--border);
      padding: 7px 9px;
      text-align: left;
      vertical-align: top;
    }

    .data-table th {
      background-color: var(--navy);
      color: #FFFFFF;
      font-weight: 800;
    }

    .data-table tr:nth-child(even) td {
      background-color: var(--surface-2);
    }

    .red-flag-box {
      margin-top: 12px;
      background-color: var(--red-soft);
      border: 1px solid #FCA5A5;
      border-left: 5px solid var(--red);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      font-size: 12px;
      color: #7F1D1D;
    }

    .system-block {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
      margin-bottom: 16px;
      box-shadow: var(--shadow);
    }

    .system-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
    }

    .system-title {
      margin: 0;
      font-size: 17px;
      font-weight: 900;
      color: var(--navy);
    }

    .symptom-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 10px;
    }

    .symptom-row {
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      background-color: var(--surface-2);
    }

    .symptom-disease {
      font-size: 13px;
      font-weight: 800;
      color: var(--navy);
    }

    .symptom-line {
      font-size: 12px;
      color: var(--text);
      margin-top: 3px;
    }

    .opd-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
      gap: 10px;
    }

    .opd-card {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 11px 13px;
      box-shadow: 0 1px 4px rgba(11, 30, 70, 0.04);
    }

    .opd-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
    }

    .opd-num {
      font-size: 11px;
      font-weight: 900;
      background-color: var(--navy);
      color: #FFFFFF;
      padding: 2px 7px;
      border-radius: 6px;
    }

    .opd-cat {
      font-size: 10px;
      font-weight: 800;
      color: var(--green-dark);
    }

    .opd-clues {
      font-size: 12px;
      color: var(--text);
      margin-bottom: 6px;
    }

    .opd-answer {
      font-size: 13px;
      font-weight: 800;
      color: var(--navy);
      background-color: var(--green-soft);
      border: 1px solid #A7F3D0;
      border-radius: 6px;
      padding: 5px 8px;
    }

    .opd-answer.masked {
      background-color: var(--amber-soft);
      border-color: #FDE68A;
      color: var(--amber);
    }

    /* =========================================================================
       QUIZ & CASE STUDIES
       ========================================================================= */
    .quiz-box,
    .case-box {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: var(--shadow);
    }

    .choice-btn {
      display: block;
      width: 100%;
      text-align: left;
      border: 1px solid var(--border);
      background-color: var(--surface-2);
      color: var(--text);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .choice-btn:hover {
      border-color: var(--navy);
      background-color: var(--navy-soft);
    }

    .choice-btn.correct {
      background-color: var(--green-soft);
      border-color: var(--green);
      color: var(--green-dark);
    }

    .choice-btn.wrong {
      background-color: var(--red-soft);
      border-color: var(--red);
      color: var(--red);
    }

    .feedback-banner {
      margin-top: 10px;
      padding: 12px;
      border-radius: var(--radius-sm);
      background-color: var(--navy-soft);
      border: 1px solid #BFDBFE;
      color: var(--navy);
      font-size: 13px;
    }

    .site-footer {
      background-color: var(--surface);
      border-top: 1px solid var(--border);
      padding: 16px 18px;
      text-align: center;
      font-size: 12px;
      color: var(--muted);
    }

    @media (max-width: 640px) {
      .cards-grid,
      .meds-grid,
      .symptom-list,
      .opd-grid {
        grid-template-columns: 1fr;
      }
      .auth-input {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <!-- =======================================================================
       1. BRAND LOGO HEADER & 2. CLINICIAN LOGIN / GUEST ACCESS BAR
       ======================================================================= -->
  <header class="site-header">
    <div class="header-inner">
      <div class="brand-lockup">
        <!-- Custom HILAAC HEALTH CENTER™ Logo SVG (#0B1E46 Navy + #059669 Green + Tm) -->
        <svg width="64" height="64" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" aria-label="Hilaac Health Center Logo">
          <rect x="2" y="2" width="116" height="116" rx="16" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="2" />
          <text x="82" y="22" fill="#0B1E46" font-family="Arial, sans-serif" font-weight="900" font-size="13">Tm</text>
          <rect x="25" y="26" width="20" height="60" rx="2" fill="#0B1E46" />
          <rect x="75" y="26" width="20" height="60" rx="2" fill="#059669" />
          <rect x="25" y="48" width="70" height="16" rx="2" fill="#059669" />
          <text x="60" y="105" text-anchor="middle" fill="#0B1E46" font-family="Arial, sans-serif" font-weight="900" font-size="9.2">HILAAC HEALTH CENTER</text>
        </svg>
        <div>
          <div class="brand-name-row">
            <span class="brand-title">HILAAC HEALTH CENTER™</span>
            <span class="brand-tagline">Clinical Reference &amp; Study Suite</span>
          </div>
          <div style="font-size: 11px; color: var(--muted);">
            Visual Pharmacology • Clinical Protocols • 49 Symptoms • 100 OPD Guides • Quiz &amp; Cases
          </div>
        </div>
      </div>

      <!-- Clinician Sign-In / Guest Toggle, Role Display & Logout -->
      <div class="auth-bar" id="authBar">
        <span id="roleBadge" class="auth-badge">Role: Guest Learner</span>
        <input id="clinicianNameInput" type="text" class="auth-input" placeholder="Clinician / Student Name" aria-label="Clinician Name" />
        <button type="button" class="btn btn-green" onclick="loginClinician()">Clinician Sign-In</button>
        <button type="button" class="btn btn-navy" onclick="switchToGuest()">Guest Mode</button>
        <button type="button" class="btn btn-red-outline" onclick="logoutSession()">Logout</button>
      </div>
    </div>

    <!-- =====================================================================
         3. STRICT SECTION NAVIGATION TABS
         ===================================================================== -->
    <nav class="nav-strip" aria-label="Clinical Sections">
      <div class="nav-inner">
        <button id="nav-pharmacology" type="button" class="nav-tab active" onclick="openSection('pharmacology')">Pharmacology</button>
        <button id="nav-treatment" type="button" class="nav-tab" onclick="openSection('treatment')">Clinical Treatment</button>
        <button id="nav-symptoms" type="button" class="nav-tab" onclick="openSection('symptoms')">Clinical Symptoms</button>
        <button id="nav-opd" type="button" class="nav-tab" onclick="openSection('opd')">OPD Diagnosis</button>
        <button id="nav-quiz" type="button" class="nav-tab" onclick="openSection('quiz')">Quiz</button>
        <button id="nav-cases" type="button" class="nav-tab" onclick="openSection('cases')">Case Studies</button>
      </div>
    </nav>
  </header>

  <main class="main-wrap">

    <!-- =====================================================================
         SECTION A: PHARMACOLOGY (STRICTLY MEDICATIONS & DRUG CLASSES + #1-#209)
         ===================================================================== -->
    <section id="sec-pharmacology" class="section-view active">
      <div class="section-banner">
        <h1>Pharmacology — Medications &amp; Drug Classes</h1>
        <p>Dedicated strictly to medications, drug classes, mechanisms of action, target organs, safety/antidotes, and the complete #1–#209 formulary.</p>
      </div>

      <div class="controls-panel">
