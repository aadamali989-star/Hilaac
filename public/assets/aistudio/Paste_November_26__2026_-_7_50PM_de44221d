        var item209 = filtered209[x];
        mHtml += '<div class="med-item">';
        mHtml += '<div class="med-num">#' + item209.num + '</div>';
        mHtml += '<div class="med-name">' + item209.name + '</div>';
        mHtml += '<span class="med-cond">' + item209.cond + '</span>';
        mHtml += '<p class="med-note">' + item209.note + '</p>';
        mHtml += '</div>';
      }
      top209Grid.innerHTML = mHtml || '<p style="color:var(--muted);">No medications (#1–#209) match your filter.</p>';
    }

    function mapConditionToDrugClass(cond) {
      if (cond === 'Hypertension') return 'Cardiovascular';
      if (cond === 'Bacterial Inf' || cond === 'Typhoid' || cond === 'Tuberculosis' || cond === 'UTI') return 'Antibiotics';
      if (cond === 'Asthma' || cond === 'COPD' || cond === 'Cough' || cond === 'Common Cold') return 'Respiratory';
      if (/Anemia|Hypothyroid|Hyperthyroid|Diabetes|Obesity|Vitamin D/i.test(cond)) return 'Endocrine & Metabolic';
      if (/Epilepsy|Parkinson|Anxiety|Depression|Migraine|Headache|Muscle Spasm/i.test(cond)) return 'CNS & Psychiatric';
      return 'GI & Analgesics';
    }

    function renderTreatment() {
      var container = document.getElementById('treatmentProtocolsContainer');
      if (!container) return;
      var html = '';
      for (var i = 0; i < treatmentProtocols.length; i++) {
        var p = treatmentProtocols[i];
        html += '<article class="protocol-card">';
        html += '<div class="protocol-top">';
        html += '<h3 class="protocol-title">' + (i + 1) + '. ' + p.title + '</h3>';
        html += '<span class="med-cond" style="margin:0;">' + p.badge + '</span>';
        html += '</div>';
        html += '<p style="font-size:13px;margin:0 0 12px;">' + p.summary + '</p>';

        html += '<div class="protocol-grid">';
        for (var s = 0; s < p.sections.length; s++) {
          var sec = p.sections[s];
          html += '<div class="band-box band-blue"><span class="band-title">' + sec.heading + '</span><ul>';
          for (var li = 0; li < sec.items.length; li++) {
            html += '<li>' + sec.items[li] + '</li>';
          }
          html += '</ul></div>';
        }
        html += '</div>';

        html += '<table class="data-table"><thead><tr>';
        for (var h = 0; h < p.table.headers.length; h++) {
          html += '<th>' + p.table.headers[h] + '</th>';
        }
        html += '</tr></thead><tbody>';
        for (var r = 0; r < p.table.rows.length; r++) {
          html += '<tr>';
          for (var c = 0; c < p.table.rows[r].length; c++) {
            html += '<td>' + p.table.rows[r][c] + '</td>';
          }
          html += '</tr>';
        }
        html += '</tbody></table>';

        html += '<div class="red-flag-box"><strong>RED FLAGS – REFER / ESCALATE URGENTLY:</strong> ' + p.redFlags + '</div>';
        html += '</article>';
      }
      container.innerHTML = html;
    }

    function renderSymptoms() {
      var container = document.getElementById('symptomsSystemsContainer');
      if (!container) return;
      var html = '';
      for (var i = 0; i < symptomSystems.length; i++) {
        var sys = symptomSystems[i];
        html += '<div class="system-block">';
        html += '<div class="system-header">' + svgOrganVisual(sys.organ) + '<h3 class="system-title">' + sys.system + '</h3></div>';
        html += '<div class="symptom-list">';
        for (var d = 0; d < sys.diseases.length; d++) {
          var dis = sys.diseases[d];
          html += '<div class="symptom-row">';
          html += '<div class="symptom-disease">' + (d + 1) + '. ' + dis.name + '</div>';
          html += '<div class="symptom-line">' + dis.line + '</div>';
          html += '</div>';
        }
        html += '</div></div>';
      }
      container.innerHTML = html;
    }

    function toggleOPDSelfTest() {
      opdSelfTestMode = !opdSelfTestMode;
      var btn = document.getElementById('opdSelfTestBtn');
      if (btn) {
        btn.textContent = opdSelfTestMode ? 'Self-Test Mode: ON' : 'Self-Test Mode: OFF';
        btn.className = opdSelfTestMode ? 'btn btn-green' : 'btn btn-navy';
      }
      renderOPD();
    }

    function revealAllOPD() {
      for (var i = 0; i < opdEntries.length; i++) {
        opdRevealedMap[opdEntries[i].num] = true;
      }
      renderOPD();
    }

    function revealSingleOPD(num) {
      opdRevealedMap[num] = !opdRevealedMap[num];
      renderOPD();
    }

    function renderOPD() {
      var container = document.getElementById('opdGuideGrid');
      if (!container) return;
      var q = (document.getElementById('opdSearchInput')?.value || '').trim().toLowerCase();
      var html = '';
      for (var i = 0; i < opdEntries.length; i++) {
        var e = opdEntries[i];
        var txt = (e.num + ' ' + e.cat + ' ' + e.clues + ' ' + e.dx).toLowerCase();
        if (q && txt.indexOf(q) === -1) continue;

        var isShown = !opdSelfTestMode || !!opdRevealedMap[e.num];
        html += '<div class="opd-card">';
        html += '<div class="opd-head"><span class="opd-num">#' + e.num + '</span><span class="opd-cat">' + e.cat + '</span></div>';
        html += '<div class="opd-clues">' + e.clues + '</div>';
        if (isShown) {
          html += '<div class="opd-answer">➔ ' + e.dx + '</div>';
          if (opdSelfTestMode) {
            html += '<button type="button" class="btn" style="margin-top:6px;padding:4px 8px;font-size:11px;" onclick="revealSingleOPD(\'' + e.num + '\')">Hide Answer</button>';
          }
        } else {
          html += '<div class="opd-answer masked">Diagnosis Hidden (Self-Test)</div>';
          html += '<button type="button" class="btn btn-navy" style="margin-top:6px;padding:4px 9px;font-size:11px;" onclick="revealSingleOPD(\'' + e.num + '\')">Show Answer</button>';
        }
        html += '</div>';
      }
      container.innerHTML = html || '<p style="color:var(--muted);">No OPD entries match your search.</p>';
    }

    function renderQuiz() {
      var container = document.getElementById('quizContainer');
      if (!container) return;

      if (quizState.index >= quizQuestions.length) {
        container.innerHTML =
          '<div class="quiz-box">' +
          '<h3 class="protocol-title">Quiz Complete!</h3>' +
          '<p style="font-size:14px;">Your Score: <strong>' + quizState.score + ' / ' + quizQuestions.length + '</strong></p>' +
          '<button type="button" class="btn btn-green" onclick="restartQuiz()">Restart Quiz</button>' +
          '</div>';
        return;
      }

      var item = quizQuestions[quizState.index];
      var html = '<div class="quiz-box">';
      html += '<div style="font-size:12px;font-weight:800;color:var(--green-dark);margin-bottom:6px;">Question ' + (quizState.index + 1) + ' of ' + quizQuestions.length + ' • Score: ' + quizState.score + '</div>';
      html += '<h3 class="protocol-title" style="font-size:16px;margin-bottom:12px;">' + item.q + '</h3>';

      for (var i = 0; i < item.opts.length; i++) {
        var btnCls = 'choice-btn';
        if (quizState.answered) {
          if (i === item.ans) btnCls += ' correct';
          else if (i === quizState.selected) btnCls += ' wrong';
        }
        html += '<button type="button" class="' + btnCls + '" onclick="selectQuizAnswer(' + i + ')">' + item.opts[i] + '</button>';
      }

      if (quizState.answered) {
        var ok = quizState.selected === item.ans;
        html += '<div class="feedback-banner">';
        html += '<strong>' + (ok ? 'Correct!' : 'Review Explanation:') + '</strong> ' + item.why;
        html += '<div style="margin-top:10px;"><button type="button" class="btn btn-navy" onclick="nextQuizItem()">Next Question ➔</button></div>';
        html += '</div>';
      }

      html += '</div>';
      container.innerHTML = html;
    }

    function selectQuizAnswer(idx) {
      if (quizState.answered) return;
      quizState.answered = true;
      quizState.selected = idx;
      if (idx === quizQuestions[quizState.index].ans) {
        quizState.score += 1;
      }
      renderQuiz();
    }

    function nextQuizItem() {
      quizState.index += 1;
      quizState.answered = false;
      quizState.selected = -1;
      renderQuiz();
    }

    function restartQuiz() {
      quizState = { index: 0, score: 0, answered: false, selected: -1 };
      renderQuiz();
    }

    function renderCases() {
      var container = document.getElementById('casesContainer');
      if (!container) return;
      var html = '';
      for (var i = 0; i < caseStudies.length; i++) {
        var cs = caseStudies[i];
        var chosen = caseAnsweredMap[i];
        html += '<article class="case-box">';
        html += '<h3 class="protocol-title" style="font-size:16px;margin-bottom:6px;">' + cs.title + '</h3>';
        html += '<p style="font-size:13px;margin:0 0 8px;"><strong>Presentation:</strong> ' + cs.vignette + '</p>';
        html += '<p style="font-size:13px;font-weight:700;color:var(--navy);margin:0 0 10px;">' + cs.prompt + '</p>';

        for (var c = 0; c < cs.choices.length; c++) {
          var cls = 'choice-btn';
          if (chosen !== undefined) {
            if (c === cs.correct) cls += ' correct';
            else if (c === chosen) cls += ' wrong';
          }
          html += '<button type="button" class="' + cls + '" onclick="answerCase(' + i + ',' + c + ')">' + cs.choices[c] + '</button>';
        }

        if (chosen !== undefined) {
          html += '<div class="feedback-banner"><strong>Clinical Rationale:</strong> ' + cs.rationale + '</div>';
        }
        html += '</article>';
      }
      container.innerHTML = html;
    }

    function answerCase(caseIdx, choiceIdx) {
      caseAnsweredMap[caseIdx] = choiceIdx;
      renderCases();
    }

    // Initial render on load
    buildDrugClassPills();
    renderPharmacology();
    renderTreatment();
    renderSymptoms();
    renderOPD();
    renderQuiz();
    renderCases();
  </script>
</body>
</html>